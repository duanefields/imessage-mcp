# iMessage MCP Server Configuration

# Transport: "stdio" (default) or "http"
# IMESSAGE_MCP_TRANSPORT=stdio

# HTTP server settings, used only when IMESSAGE_MCP_TRANSPORT=http.
# Bind to localhost and reach it through a tunnel or reverse proxy. Pick an
# unremarkable port rather than 8080, which collides with the first thing any
# other developer tool tries, and stay below 49152 so it cannot clash with an
# outbound ephemeral socket.
# IMESSAGE_MCP_HOST=127.0.0.1
# IMESSAGE_MCP_PORT=18791

# Set to false to give each HTTP client a session. The default is stateless --
# a fresh transport per request -- because a remote client is often dialed from
# a pool of addresses, and a request arriving from a different address than the
# one that opened the session is rejected. Nothing here needs session state.
# IMESSAGE_MCP_STATELESS=true

# Authentication for the HTTP transport: "none" (default) or "password".
# It never applies to stdio, which is secured by the fact that running it means
# already having a shell on the machine.
#
# "password" runs a self-contained OAuth 2.1 authorization server guarded by a
# single shared password. Use it whenever the server is reachable from outside
# the machine. There is no version of this server that should be exposed to a
# network without it: it reads a personal message archive.
# IMESSAGE_MCP_AUTH=none

# The shared password, required when IMESSAGE_MCP_AUTH=password. It is the only
# credential protecting the archive, so make it long and random:
#   python3 -c "import uuid; print(uuid.uuid4())"
# IMESSAGE_MCP_PASSWORD=

# The public URL clients reach this server on, required when
# IMESSAGE_MCP_AUTH=password. This becomes the OAuth issuer and must match what
# clients dial exactly, including the scheme. Getting it wrong produces a 401
# that does not explain itself.
# IMESSAGE_MCP_BASE_URL=https://imessage.example.com

# Where registered clients and issued tokens are persisted, so a restart does
# not force every client to authorize again. Defaults to ~/.imessage-mcp.
# IMESSAGE_MCP_STATE_DIR=~/.imessage-mcp

# Path to the message database. Defaults to ~/Library/Messages/chat.db, which
# is almost always right; this exists so tests and experiments can point
# somewhere else.
# IMESSAGE_MCP_DB_PATH=
